    "API Key 获取方式：面板 → 设置 → API 接口 → 开启并复制" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To get the API Key: Panel → Settings → API Interface → enable and copy"
