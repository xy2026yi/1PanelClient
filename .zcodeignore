# macOS
.DS_Store
.AppleDouble
.LSOverride

# Xcode
xcuserdata/
*.xcuserstate
*.xcscmblueprint
DerivedData/

# 打包产物（build-ipa.sh 生成）
build/

# Logs（仅根目录的抓包文档目录，避免误匹配 Features/Logs）
/logs/
*.log

# Python
__pycache__/
*.pyc

# Sensitive
*.env
*.key
# 面板登录凭据（get-doc-json.py 本地配置，含密码/公钥/接口密钥）
1PanelClient/scripts/.panel_env

# 归档目录（历史开发文档/抓包/旧产物，本地保留、不入库）
/archive/

.zcode/

# mimosa 安全扫描插件的运行时产物（hook-state 等）
.mimosa/

# ZCode 临时验证工程（编辑器视觉回归用，不进仓库）
.zcode-scratch/

# ===== ↑ 以上同步自 .gitignore（「从 .gitignore 同步」只重写以上部分）=====
.git/
.hg/
.svn/
node_modules/
bower_components/
jspm_packages/
site-packages/
venv/
coverage/
htmlcov/
lcov-report/
cmakefiles/
cmake-build-*/
bazel-*/
pods/
deriveddata/
storybook-static/
playwright-report/
test-results/
allure-results/
allure-report/
cdk.out/
*.egg-info/
*.dist-info/
eggs/
pip-wheel-metadata/
wheels/
